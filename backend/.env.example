# ============================================================
# ParkinsonXAI Backend — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your real values.
# DO NOT commit .env to version control.
# ============================================================

# ── MongoDB Atlas ─────────────────────────────────────────────
# Get this from: https://cloud.mongodb.com → your cluster → Connect
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/

# Name of the database (will be auto-created on first write)
DATABASE_NAME=parkinson_xai

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# ── Model Paths ───────────────────────────────────────────────
# Relative path from backend/ folder to the models/ folder
MODEL_BASE_PATH=../models
